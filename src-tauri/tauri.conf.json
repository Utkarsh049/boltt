{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "boltt",
  "version": "1.1.0",
  "identifier": "com.boltt.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Boltt",
        "decorations": false,
        "width": 1000,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "zoomHotkeysEnabled": false,
        "additionalBrowserArgs": "--disable-pinch",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFODBFOTE5NkZEODc1RTMKUldUamRkaHZHZW1BSGhJQk1nZDIyR1l2eitxWklON0NCMTd2UEtEd0k4OVR1ZG5hZEJTc1BQSngK",
      "endpoints": [
        "https://github.com/Utkarsh049/boltt/releases/latest/download/latest.json"
      ]
    }
  }
}
